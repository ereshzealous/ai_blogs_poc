diff --color -ruN base/monolith/teams.py m1/monolith/teams.py
--- a/monolith/teams.py	1970-01-01 05:30:00
+++ b/monolith/teams.py	2026-09-16 21:29:22
@@ -0,0 +1,32 @@
+"""Teams channel for the monolith. Teams cannot wait on a blocking prompt, so approvals go through card actions."""
+
+from __future__ import annotations
+
+import re
+from typing import Any
+
+from fastapi import APIRouter, Request
+
+from monolith.api import AGENTS, PENDING, agent_for
+
+router = APIRouter()
+
+
+@router.post("/teams/messages")
+async def messages(request: Request) -> dict[str, Any]:
+    activity = await request.json()
+    conversation = activity.get("conversation", {}).get("id", "default")
+    user = activity.get("from", {}).get("name", "unknown")
+    if activity.get("type") == "invoke":
+        pending = PENDING.get(conversation)
+        if not pending:
+            return {"type": "message", "text": "Nothing to approve."}
+        pending["approved"] = activity.get("value", {}).get("action") == "approve"
+        pending["event"].set()
+        return {"type": "message", "text": f"{user}: decision recorded."}
+    if not re.search(r"\bINC-\d+\b", activity.get("text", "")):
+        return {"type": "message", "text": "Mention an incident id, e.g. INC-4917."}
+    agent = await agent_for(conversation, user, output="teams")
+    answer = await agent.run(activity["text"])
+    return {"type": "message", "attachments": [{"contentType": "application/vnd.microsoft.card.adaptive",
+            "content": {"type": "AdaptiveCard", "version": "1.5", "body": [{"type": "TextBlock", "wrap": True, "text": answer}]}}]}
