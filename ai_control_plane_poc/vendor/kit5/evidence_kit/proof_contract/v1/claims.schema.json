{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "pae-proof/v1/claims",
 "title": "proof/claims.toml · pae-proof/v1",
 "type": "object",
 "required": [
  "claims"
 ],
 "properties": {
  "claims": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "statement",
     "type",
     "verdict",
     "article"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[A-Z][0-9]+-C[0-9]{2}$"
     },
     "statement": {
      "type": "string"
     },
     "type": {
      "enum": [
       "implementation",
       "measured",
       "architecture+measured",
       "control",
       "limitation"
      ]
     },
     "verdict": {
      "enum": [
       "supported",
       "contradicted",
       "not_established",
       "implementation",
       "control",
       "limitation"
      ]
     },
     "experiments": {
      "type": "array"
     },
     "checks": {
      "type": "array"
     },
     "article": {
      "type": "array",
      "minItems": 1
     },
     "facts": {
      "type": "array"
     },
     "rests_on": {
      "type": "string"
     }
    }
   }
  }
 }
}
