# Copy to .env (git-ignored, never commit it) and pass it to uv:
#   uv run --env-file .env python -m benchmark.runner selection --run-id my-openai-run --provider openai --model <model-id>
# or load it for every `uv run` in this shell:  export UV_ENV_FILE=.env
#
# The default local run (Ollama on this machine) needs none of these.

# Only for --provider openai
OPENAI_API_KEY=

# Optional: an OpenAI-compatible Chat Completions endpoint instead of api.openai.com
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Ollama on another host or port (model and embeddings), e.g. from inside Docker
# OLLAMA_URL=http://localhost:11434
