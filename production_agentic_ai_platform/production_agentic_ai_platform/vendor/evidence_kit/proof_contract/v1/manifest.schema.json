{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "pae-proof/v1/manifest",
 "title": "Run manifest · pae-proof/v1",
 "description": "One standardized run: identity, environment, benchmark, execution profile, entry points, integrity and the provenance of every field (recorded, frozen or reconstructed).",
 "type": "object",
 "required": [
  "schema",
  "series",
  "article_id",
  "poc",
  "run_id",
  "scenario",
  "source_commit",
  "runtime_mode",
  "started_at",
  "completed_at",
  "environment",
  "benchmark",
  "execution_profile",
  "entrypoints",
  "integrity",
  "provenance"
 ],
 "properties": {
  "schema": {
   "const": "pae-proof/v1"
  },
  "series": {
   "type": "string"
  },
  "article_id": {
   "type": "string",
   "pattern": "^[A-Z][0-9]+$"
  },
  "poc": {
   "type": "string"
  },
  "run_id": {
   "type": "string"
  },
  "scenario": {
   "type": "string"
  },
  "source_commit": {
   "type": "string"
  },
  "runtime_mode": {
   "type": "string"
  },
  "started_at": {
   "type": "string"
  },
  "completed_at": {
   "type": "string"
  },
  "environment": {
   "type": "object",
   "required": [
    "os",
    "arch",
    "python",
    "model_runtime",
    "model",
    "model_version",
    "temperature",
    "seed"
   ]
  },
  "benchmark": {
   "type": "object",
   "required": [
    "modes"
   ],
   "properties": {
    "modes": {
     "type": "array",
     "minItems": 1
    }
   }
  },
  "execution_profile": {
   "type": "object",
   "required": [
    "classes",
    "groups"
   ],
   "properties": {
    "classes": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/cls"
     }
    },
    "groups": {
     "type": "array"
    }
   }
  },
  "entrypoints": {
   "type": "object",
   "required": [
    "verify"
   ]
  },
  "integrity": {
   "type": "object",
   "required": [
    "sha256sums"
   ]
  },
  "provenance": {
   "type": "object",
   "required": [
    "manifest_origin",
    "fields"
   ]
  }
 },
 "$defs": {
  "cls": {
   "type": "object",
   "required": [
    "class",
    "items"
   ],
   "properties": {
    "class": {
     "enum": [
      "REAL",
      "SIMULATED",
      "RECORDED",
      "GENERATED",
      "INJECTED",
      "ARCHITECTURE"
     ]
    },
    "items": {
     "type": "array"
    }
   }
  }
 }
}
