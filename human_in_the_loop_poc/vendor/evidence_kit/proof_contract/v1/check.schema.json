{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "pae-proof/v1/check",
 "title": "One line of checks.jsonl · pae-proof/v1",
 "type": "object",
 "required": [
  "id",
  "experiment",
  "description",
  "kind",
  "fact",
  "op",
  "expected",
  "actual",
  "invariant_held",
  "status",
  "evidence"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[A-Z][0-9]+-R[0-9]+-C[0-9]{2}$"
  },
  "experiment": {
   "type": "string",
   "pattern": "^[A-Z][0-9]+-R[0-9]+$"
  },
  "description": {
   "type": "string"
  },
  "kind": {
   "enum": [
    "invariant",
    "hypothesis",
    "confirmatory",
    "measurement",
    "replay",
    "control",
    "implementation"
   ]
  },
  "fact": {
   "type": "string"
  },
  "op": {
   "enum": [
    "==",
    "!=",
    "<",
    "<=",
    ">",
    ">=",
    "within",
    "in",
    "not in"
   ]
  },
  "expected": {
   "type": "string"
  },
  "actual": {
   "type": "string"
  },
  "invariant_held": {
   "type": "boolean"
  },
  "status": {
   "enum": [
    "PASS",
    "FAIL",
    "EXPECTED_FAILURE"
   ]
  },
  "evidence": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "path"
    ]
   }
  },
  "rows": {
   "type": [
    "object",
    "null"
   ]
  }
 }
}
