{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "pae-proof/v1/results",
 "title": "Results · pae-proof/v1",
 "description": "The canonical results of one run, derived by an adapter from the benchmark's own output.",
 "type": "object",
 "required": [
  "schema",
  "contract",
  "run_id",
  "article",
  "status",
  "check_counts",
  "experiments",
  "checks",
  "claims",
  "profile",
  "facts"
 ],
 "properties": {
  "schema": {
   "const": "pae-proof/v1"
  },
  "run_id": {
   "type": "string"
  },
  "status": {
   "enum": [
    "COMPLETE",
    "PARTIAL"
   ]
  },
  "check_counts": {
   "type": "object",
   "required": [
    "experiments",
    "checks",
    "pass",
    "fail",
    "expected_failure"
   ]
  },
  "experiments": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "title",
     "question",
     "result",
     "checks",
     "counts"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[A-Z][0-9]+-R[0-9]+$"
     },
     "title": {
      "type": "string"
     },
     "question": {
      "type": "string"
     },
     "result": {
      "enum": [
       "PASS",
       "FAIL",
       "EXPECTED_FAILURE"
      ]
     },
     "checks": {
      "type": "array",
      "minItems": 1
     }
    }
   }
  },
  "checks": {
   "type": "array"
  },
  "claims": {
   "type": "array"
  },
  "facts": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": [
     "value",
     "display"
    ]
   }
  }
 }
}
