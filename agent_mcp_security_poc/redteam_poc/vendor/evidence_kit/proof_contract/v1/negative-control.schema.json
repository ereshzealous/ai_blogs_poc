{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "pae-proof/v1/negative-control",
 "title": "Negative control results · pae-proof/v1",
 "type": "object",
 "required": [
  "schema",
  "safeguard_removed",
  "invariant",
  "expected",
  "governed",
  "mutated",
  "harness_completed",
  "result"
 ],
 "properties": {
  "schema": {
   "const": "pae-proof/v1"
  },
  "result": {
   "enum": [
    "EXPECTED_FAILURE",
    "FAIL"
   ]
  },
  "harness_completed": {
   "type": "boolean"
  }
 }
}
