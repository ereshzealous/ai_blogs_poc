{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "pae-proof/v1/experiments",
 "title": "proof/experiments.toml · pae-proof/v1",
 "type": "object",
 "required": [
  "experiments"
 ],
 "properties": {
  "experiments": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "title",
     "question",
     "claim",
     "hypothesis",
     "setup",
     "invariant",
     "checks"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[A-Z][0-9]+-R[0-9]+$"
     },
     "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "required": [
        "id",
        "description",
        "fact",
        "op"
       ]
      }
     }
    }
   }
  }
 }
}
