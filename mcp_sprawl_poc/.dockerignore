# Keep the Docker build context to what the image needs.
.venv/
**/__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.DS_Store
.env
.env.*
!.env.example
benchmark/.cache/
# Results are mounted into the container at run time (docker-compose.yml), not baked into the image.
benchmark/runs/
benchmark/reports/*/
